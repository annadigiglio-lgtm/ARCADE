{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "g5_dataverse_flussi"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "g5_office365_arcade"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "g5_EmailProva (g5_g5_EmailProva)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "g5_g5_EmailProva"
          }
        },
        "g5_EmailCommerciale (g5_EmailCommerciale)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "g5_EmailCommerciale"
          }
        },
        "g5_ModalitaProva (g5_ModalitaProva)": {
          "defaultValue": true,
          "type": "Bool",
          "metadata": {
            "schemaName": "g5_ModalitaProva"
          }
        }
      },
      "triggers": {
        "Quando_cambia_una_riga": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "g5_contratto",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "g5_stato,g5_stand,g5_edizione",
              "subscriptionRequest/filterexpression": "g5_stato ne 122540002 and _g5_stand_value ne null"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Principale": {
          "type": "Scope",
          "actions": {
            "Altri_contratti_sullo_stand": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "g5_contratti",
                  "$filter": "_g5_stand_value eq @{triggerOutputs()?['body/_g5_stand_value']} and _g5_edizione_value eq @{triggerOutputs()?['body/_g5_edizione_value']} and g5_stato ne 122540002 and g5_contrattoid ne @{triggerOutputs()?['body/g5_contrattoid']}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Se_ci_sono_doppioni": {
              "type": "If",
              "expression": {
                "greater": [
                  "@length(outputs('Altri_contratti_sullo_stand')?['body/value'])",
                  0
                ]
              },
              "actions": {
                "Avvisa_il_commerciale": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{parameters('g5_EmailCommerciale (g5_EmailCommerciale)')}",
                      "emailMessage/Subject": "@{if(or(equals(toLower(string(parameters('g5_ModalitaProva (g5_ModalitaProva)'))),'true'),equals(toLower(string(parameters('g5_ModalitaProva (g5_ModalitaProva)'))),'yes')),'[PROVA] ','')}ATTENZIONE – stand @{triggerOutputs()?['body/_g5_stand_value@OData.Community.Display.V1.FormattedValue']} venduto due volte",
                      "emailMessage/Body": "<style>table{border-collapse:collapse}th,td{border:1px solid #ccc;padding:4px 8px;font-family:Segoe UI,Arial;font-size:13px}th{background:#f2f2f2}</style><p>Lo stand <b>@{triggerOutputs()?['body/_g5_stand_value@OData.Community.Display.V1.FormattedValue']}</b> risulta in più contratti non annullati della stessa edizione.</p><p>Contratto appena salvato: <b>@{triggerOutputs()?['body/g5_id_contratto']}</b></p><p>Altri contratti: @{join(xpath(xml(json(concat('{\"r\":{\"c\":',string(outputs('Altri_contratti_sullo_stand')?['body/value']),'}}'))),'/r/c/g5_id_contratto/text()'),', ')}</p>",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Altri_contratti_sullo_stand": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Avviso_errore": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@{parameters('g5_EmailProva (g5_g5_EmailProva)')}",
              "emailMessage/Subject": "ERRORE FL-04",
              "emailMessage/Body": "<p>Il flusso <b>@{workflow()?['tags']?['flowDisplayName']}</b> è andato in errore.</p><p>Esecuzione: @{workflow()?['run']?['name']}</p><pre>@{string(result('Principale'))}</pre>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Principale": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}