{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "g5_dataverse_flussi"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "g5_office365_arcade"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "g5_EmailProva (g5_g5_EmailProva)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "g5_g5_EmailProva"
          }
        },
        "g5_ModalitaProva (g5_ModalitaProva)": {
          "defaultValue": true,
          "type": "Bool",
          "metadata": {
            "schemaName": "g5_ModalitaProva"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Codice contratto",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "es. C2026-9997",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Trova_contratto": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "g5_contratti",
              "$filter": "g5_id_contratto eq '@{trim(triggerBody()?['text'])}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Leggi_espositore": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "g5_espositori",
              "recordId": "@first(outputs('Trova_contratto')?['body/value'])?['_g5_espositore_value']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Trova_contratto": [
              "Succeeded"
            ]
          }
        },
        "Elenca_righe": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "g5_righe_contratto",
              "$filter": "_g5_contratto_value eq @{first(outputs('Trova_contratto')?['body/value'])?['g5_contrattoid']}",
              "$orderby": "g5_riga asc"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Trova_contratto": [
              "Succeeded"
            ]
          }
        },
        "Seleziona_righe": {
          "type": "Select",
          "inputs": {
            "from": "@outputs('Elenca_righe')?['body/value']",
            "select": {
              "Riga": "@item()?['g5_riga']",
              "Codice": "@item()?['g5_codice_voce']",
              "Descrizione": "@item()?['g5_descrizione']",
              "Quantità": "@item()?['g5_quantita']",
              "Prezzo unitario €": "@{formatNumber(float(coalesce(item()?['g5_prezzo_unitario'],0)),'N2','it-IT')}",
              "Importo €": "@{formatNumber(float(coalesce(item()?['g5_importo'],0)),'N2','it-IT')}"
            }
          },
          "runAfter": {
            "Elenca_righe": [
              "Succeeded"
            ]
          }
        },
        "Tabella_righe": {
          "type": "Table",
          "inputs": {
            "from": "@body('Seleziona_righe')",
            "format": "HTML"
          },
          "runAfter": {
            "Seleziona_righe": [
              "Succeeded"
            ]
          }
        },
        "Email_conferma": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@{if(or(or(equals(toLower(string(parameters('g5_ModalitaProva (g5_ModalitaProva)'))),'true'),equals(toLower(string(parameters('g5_ModalitaProva (g5_ModalitaProva)'))),'yes')),empty(outputs('Leggi_espositore')?['body/g5_email_referente'])),parameters('g5_EmailProva (g5_g5_EmailProva)'),outputs('Leggi_espositore')?['body/g5_email_referente'])}",
              "emailMessage/Subject": "@{if(or(equals(toLower(string(parameters('g5_ModalitaProva (g5_ModalitaProva)'))),'true'),equals(toLower(string(parameters('g5_ModalitaProva (g5_ModalitaProva)'))),'yes')),'[PROVA] ','')}ARCADE Milano – Conferma del contratto @{first(outputs('Trova_contratto')?['body/value'])?['g5_id_contratto']}",
              "emailMessage/Body": "<style>table{border-collapse:collapse}th,td{border:1px solid #ccc;padding:4px 8px;font-family:Segoe UI,Arial;font-size:13px}th{background:#f2f2f2}</style><p>Gentile @{outputs('Leggi_espositore')?['body/g5_referente']},</p><p>confermiamo la firma del contratto <b>@{first(outputs('Trova_contratto')?['body/value'])?['g5_id_contratto']}</b> per <b>@{outputs('Leggi_espositore')?['body/g5_ragione_sociale']}</b></p><p>Stand: <b>@{first(outputs('Trova_contratto')?['body/value'])?['_g5_stand_value@OData.Community.Display.V1.FormattedValue']}</b></p>@{body('Tabella_righe')}<p>Imponibile: <b>€ @{formatNumber(float(coalesce(first(outputs('Trova_contratto')?['body/value'])?['g5_imponibile'],0)),'N2','it-IT')}</b></p><p>Acconto 30%: € @{formatNumber(float(coalesce(mul(float(coalesce(first(outputs('Trova_contratto')?['body/value'])?['g5_imponibile'],0)),0.3),0)),'N2','it-IT')} entro il @{if(empty(first(outputs('Trova_contratto')?['body/value'])?['g5_acconto_scadenza']),'da definire',formatDateTime(first(outputs('Trova_contratto')?['body/value'])?['g5_acconto_scadenza'],'dd/MM/yyyy'))}<br>Saldo 70%: € @{formatNumber(float(coalesce(mul(float(coalesce(first(outputs('Trova_contratto')?['body/value'])?['g5_imponibile'],0)),0.7),0)),'N2','it-IT')} entro il @{if(empty(first(outputs('Trova_contratto')?['body/value'])?['g5_saldo_scadenza']),'da definire',formatDateTime(first(outputs('Trova_contratto')?['body/value'])?['g5_saldo_scadenza'],'dd/MM/yyyy'))}</p><p>Cordiali saluti,<br>Ufficio commerciale ARCADE Milano</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Leggi_espositore": [
              "Succeeded"
            ],
            "Tabella_righe": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}