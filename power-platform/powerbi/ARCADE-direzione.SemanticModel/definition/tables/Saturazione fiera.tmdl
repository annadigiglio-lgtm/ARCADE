table 'Saturazione fiera'

	measure 'Saturazione della fiera' = MAX('Saturazione fiera'[saturazione_mq])
		formatString: 0.0%

	measure 'Stand venduti fiera' = SUM('Saturazione fiera'[stand_venduti])
		formatString: #,0

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column padiglione
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: padiglione

	column stand_disponibili
		dataType: int64
		summarizeBy: none
		sourceColumn: stand_disponibili

	column stand_venduti
		dataType: int64
		summarizeBy: none
		sourceColumn: stand_venduti

	column mq_disponibili
		dataType: double
		summarizeBy: none
		sourceColumn: mq_disponibili

	column mq_venduti
		dataType: double
		summarizeBy: none
		sourceColumn: mq_venduti

	column saturazione_mq
		dataType: double
		summarizeBy: none
		sourceColumn: saturazione_mq

	partition 'Saturazione fiera' = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_kpi_saturazione"]}[Data],
			    Righe = Table.SelectRows(Vista, each [padiglione] = null),
			    Tipi = Table.TransformColumnTypes(Righe, {{"edizione", type text}, {"padiglione", type text}, {"stand_disponibili", Int64.Type}, {"stand_venduti", Int64.Type}, {"mq_disponibili", type number}, {"mq_venduti", type number}, {"saturazione_mq", type number}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "padiglione", "stand_disponibili", "stand_venduti", "mq_disponibili", "mq_venduti", "saturazione_mq"})
			in
			    Colonne
