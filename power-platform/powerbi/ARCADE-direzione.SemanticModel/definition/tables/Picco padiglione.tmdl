table 'Picco padiglione'

	measure 'Picco del padiglione' = MAX('Picco padiglione'[presenti])
		formatString: #,0

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column padiglione
		dataType: string
		summarizeBy: none
		sourceColumn: padiglione

	column istante
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		summarizeBy: none
		sourceColumn: istante

	column presenti
		dataType: double
		summarizeBy: none
		sourceColumn: presenti

	partition 'Picco padiglione' = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_kpi_picco_padiglione"]}[Data],
			    Righe = Table.TransformColumns(Vista, {{"istante", each DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_, 1)), type datetime}}),
			    Tipi = Table.TransformColumnTypes(Righe, {{"edizione", type text}, {"padiglione", type text}, {"istante", type datetime}, {"presenti", type number}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "padiglione", "istante", "presenti"})
			in
			    Colonne
