table 'Visitatori giorno'

	measure 'Visitatori del giorno' = SUM('Visitatori giorno'[visitatori])
		formatString: #,0

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column giorno
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: giorno

	column visitatori
		dataType: double
		summarizeBy: none
		sourceColumn: visitatori

	column biglietti
		dataType: int64
		summarizeBy: none
		sourceColumn: biglietti

	partition 'Visitatori giorno' = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_kpi_visitatori_giorno"]}[Data],
			    Tipi = Table.TransformColumnTypes(Vista, {{"edizione", type text}, {"giorno", type date}, {"visitatori", type number}, {"biglietti", Int64.Type}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "giorno", "visitatori", "biglietti"})
			in
			    Colonne
