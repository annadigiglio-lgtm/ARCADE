table 'Ricavo padiglione'

	measure 'Ricavo per mq' = MAX('Ricavo padiglione'[ricavo_per_mq])
		formatString: #,0 €

	measure 'Ricavo dei padiglioni' = SUM('Ricavo padiglione'[ricavo])
		formatString: #,0 €

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column padiglione
		dataType: string
		summarizeBy: none
		sourceColumn: padiglione

	column ricavo
		dataType: double
		summarizeBy: none
		sourceColumn: ricavo

	column mq_venduti
		dataType: double
		summarizeBy: none
		sourceColumn: mq_venduti

	column ricavo_per_mq
		dataType: double
		summarizeBy: none
		sourceColumn: ricavo_per_mq

	partition 'Ricavo padiglione' = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_kpi_ricavo_mq"]}[Data],
			    Righe = Table.SelectRows(Vista, each [padiglione] <> null),
			    Tipi = Table.TransformColumnTypes(Righe, {{"edizione", type text}, {"padiglione", type text}, {"ricavo", type number}, {"mq_venduti", type number}, {"ricavo_per_mq", type number}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "padiglione", "ricavo", "mq_venduti", "ricavo_per_mq"})
			in
			    Colonne
