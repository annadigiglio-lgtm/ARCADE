table Conversione

	measure 'Tasso di conversione' = MAX(Conversione[tasso_conversione])
		formatString: 0.0%

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column biglietti_venduti
		dataType: int64
		summarizeBy: none
		sourceColumn: biglietti_venduti

	column biglietti_entrati
		dataType: int64
		summarizeBy: none
		sourceColumn: biglietti_entrati

	column tasso_conversione
		dataType: double
		summarizeBy: none
		sourceColumn: tasso_conversione

	partition Conversione = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_kpi_conversione"]}[Data],
			    Tipi = Table.TransformColumnTypes(Vista, {{"edizione", type text}, {"biglietti_venduti", Int64.Type}, {"biglietti_entrati", Int64.Type}, {"tasso_conversione", type number}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "biglietti_venduti", "biglietti_entrati", "tasso_conversione"})
			in
			    Colonne
