table Visitatori

	measure 'Visitatori giornalieri' = SUM(Visitatori[visitatori_giornalieri])
		formatString: #,0

	measure 'Ingressi ai padiglioni' = SUM(Visitatori[ingressi_padiglioni])
		formatString: #,0

	measure 'Visitatori unici' = SUM(Visitatori[visitatori_unici])
		formatString: #,0

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column ingressi_padiglioni
		dataType: int64
		summarizeBy: none
		sourceColumn: ingressi_padiglioni

	column visitatori_giornalieri
		dataType: double
		summarizeBy: none
		sourceColumn: visitatori_giornalieri

	column visitatori_unici
		dataType: double
		summarizeBy: none
		sourceColumn: visitatori_unici

	partition Visitatori = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_kpi_visitatori"]}[Data],
			    Tipi = Table.TransformColumnTypes(Vista, {{"edizione", type text}, {"ingressi_padiglioni", Int64.Type}, {"visitatori_giornalieri", type number}, {"visitatori_unici", type number}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "ingressi_padiglioni", "visitatori_giornalieri", "visitatori_unici"})
			in
			    Colonne
