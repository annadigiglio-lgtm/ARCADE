table Presenze

	measure 'Presenti stimati' = SUM(Presenze[presenti])
		formatString: #,0

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column istante
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		summarizeBy: none
		sourceColumn: istante

	column padiglione
		dataType: string
		summarizeBy: none
		sourceColumn: padiglione

	column presenti
		dataType: double
		summarizeBy: none
		sourceColumn: presenti

	partition Presenze = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_presenze_stimate"]}[Data],
			    Righe = Table.TransformColumns(Vista, {{"istante", each DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(_, 1)), type datetime}}),
			    Tipi = Table.TransformColumnTypes(Righe, {{"edizione", type text}, {"istante", type datetime}, {"padiglione", type text}, {"presenti", type number}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "istante", "padiglione", "presenti"})
			in
			    Colonne
