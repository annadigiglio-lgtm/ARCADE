table 'Visite stand'

	measure 'Visite agli stand' = SUM('Visite stand'[scansioni])
		formatString: #,0

	column edizione
		dataType: string
		summarizeBy: none
		sourceColumn: edizione

	column codice_stand
		dataType: string
		summarizeBy: none
		sourceColumn: codice_stand

	column ora
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		summarizeBy: none
		sourceColumn: ora

	column scansioni
		dataType: int64
		summarizeBy: none
		sourceColumn: scansioni

	column padiglione
		dataType: string
		summarizeBy: none
		sourceColumn: padiglione

	column ora_del_giorno
		dataType: int64
		summarizeBy: none
		sourceColumn: ora_del_giorno

	partition 'Visite stand' = m
		mode: import
		source =
			let
			    Origine = PostgreSQL.Database(Server, Database),
			    Vista = Origine{[Schema="arcade", Item="v_visite_stand_ora"]}[Data],
			    Righe = Table.AddColumn(Vista, "padiglione", each Text.Start([codice_stand], 2), type text),
			    Ore = Table.AddColumn(Righe, "ora_del_giorno", each Time.Hour([ora]), Int64.Type),
			    Tipi = Table.TransformColumnTypes(Ore, {{"edizione", type text}, {"codice_stand", type text}, {"ora", type datetime}, {"scansioni", Int64.Type}}),
			    Colonne = Table.SelectColumns(Tipi, {"edizione", "codice_stand", "ora", "scansioni", "padiglione", "ora_del_giorno"})
			in
			    Colonne
