# Copiare in .env.docker.local (escluso da Git).
# 127.0.0.1 = solo questo PC; 0.0.0.0 = accesso anche dalla rete locale.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Database condiviso Supabase: copiare i valori dall'ambiente del progetto.
# Usare il Session pooler e l'utente bid_app, con permessi di lettura.
DB_HOST=INSERIRE_HOST_SESSION_POOLER
DB_PORT=5432
DB_NAME=postgres
DB_USER=bid_app.CODICE_PROGETTO
DB_PASSWORD=
DB_SSLMODE=require

# Chiave casuale persistente di almeno 32 byte, diversa dalla password di login.
ARCADE_JWT_SECRET=
ARCADE_DEMO_ISTANTE=2025-12-20T11:55:00+01:00
